# =============================================================================
# FeedCourier Runtime Configuration (.env.example)
# Copy to `.env` or pass as container / systemd environment variables.
# =============================================================================

# Persistent directory storing `feedcourier.db` (SQLite WAL), `master.key`, and online backups.
# Docker container image defaults to `/data`; native binary defaults to `./data`.
DATA_DIR=./data

# HTTP socket bind address serving the embedded WebUI, `/api/v1/*` REST API, and `/mcp`.
LISTEN_ADDR=0.0.0.0:8080

# Hours after discovery to retain transient HTML/media payloads before `NOT EXISTS` GC purges them.
RETENTION_HOURS=24

# Maximum concurrent connections in the read-only SQLite WAL pool (minimum: 1).
DB_READ_MAX_CONNECTIONS=8

# Structured `tracing` log filter directive.
RUST_LOG=feedcourier=info,tower_http=info

# -----------------------------------------------------------------------------
# Optional Security & Networking Presets (can also be managed in the WebUI)
# -----------------------------------------------------------------------------

# Pre-seed or rotate the single-admin WebUI password on startup (stored as Argon2id PHC hash).
# ADMIN_PASSWORD=change-me-strong-passphrase

# Explicit 32-byte ChaCha20-Poly1305 master key (64-char hex or Base64).
# When omitted, `<DATA_DIR>/master.key` is auto-generated with `0600` permissions.
# MASTER_KEY=

# Global outbound HTTP/HTTPS/SOCKS5 proxy URL (falls back to ALL_PROXY / HTTPS_PROXY / HTTP_PROXY).
# Individual feeds and delivery channels can toggle `use_proxy` independently.
# OUTBOUND_PROXY=socks5h://127.0.0.1:1080

# Comma-separated internal CIDRs or hostnames permitted past the connect-time DNS SSRF guard
# (e.g. self-hosted RSSHub or Local Telegram Bot API Server on a private LAN).
# SSRF_ALLOWLIST=10.0.0.5/32,rsshub.internal
