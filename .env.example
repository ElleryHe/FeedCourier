# =============================================================================
# FeedCourier Runtime Configuration (.env.example)
# Copy to `.env` or pass as container / systemd environment variables.
# =============================================================================

# Persistent directory storing `feedcourier.db` (SQLite WAL), `master.key`, and online backups.
# Docker container image defaults to `/data`; native binary defaults to `./data`.
DATA_DIR=./data

# HTTP socket bind address serving the embedded WebUI, `/api/v1/*` REST API, and `/mcp`.
LISTEN_ADDR=0.0.0.0:8080

# Hours after discovery to retain transient HTML/media payloads before `NOT EXISTS` GC purges them.
RETENTION_HOURS=24

# Maximum concurrent connections in the read-only SQLite WAL pool (minimum: 1).
DB_READ_MAX_CONNECTIONS=8

# Structured `tracing` log filter directive.
RUST_LOG=feedcourier=info,tower_http=info

# -----------------------------------------------------------------------------
# Optional Security & Networking Presets (can also be managed in the WebUI)
# -----------------------------------------------------------------------------

# Pre-seed or rotate the single-admin WebUI username & password on startup
# (password is stored as Argon2id PHC hash; default username is `courier`).
# ADMIN_USERNAME=courier
# ADMIN_PASSWORD=change-me-strong-passphrase

# One-shot emergency reset that clears administrator TOTP 2FA secret & recovery codes on boot.
# Remove after recovering access.
# RESET_2FA=false

# Explicit 32-byte ChaCha20-Poly1305 master key (64-char hex or Base64).
# When omitted, `<DATA_DIR>/master.key` is auto-generated with `0600` permissions.
# MASTER_KEY=

# Global outbound HTTP/HTTPS/SOCKS5 proxy URL (falls back to ALL_PROXY / HTTPS_PROXY / HTTP_PROXY).
# Feeds, Telegram, Notion, and plugins enabling `use_proxy` require a configured proxy (fail-closed);
# SMTP always connects directly over native TCP/TLS.
# OUTBOUND_PROXY=socks5h://127.0.0.1:1080

# Comma-separated internal CIDRs or hostnames permitted past the connect-time DNS SSRF guard
# (e.g. self-hosted RSSHub, YOURLS, or Local Telegram Bot API Server on a private LAN).
# SSRF_ALLOWLIST=10.0.0.5/32,rsshub.internal

# Initial default IANA timezone for delivery windows & timestamps (falls back to valid `TZ`).
# TIMEZONE=America/Los_Angeles

# Initial fallback delivery template locale (`en` or `zh-CN`) when a route omits `options.locale`.
# LOCALE=en

# Public base URL (e.g. https://feeds.example.com) enabling RFC 8058 one-click SMTP
# unsubscribe links (/u/{token}) and double-opt-in verification links (/v/{token}).
# When unset, SMTP falls back to mailto: unsubscribe and manual 6-digit code verification.
# PUBLIC_URL=https://feeds.example.com

# Trust reverse-proxy client IP headers (`X-Real-IP` / rightmost `X-Forwarded-For`) on public
# compliance endpoints (`/u/`, `/v/`). Enable ONLY behind a trusted reverse proxy (Nginx/Caddy).
# TRUST_PROXY=false

# Optional override for the plugin marketplace index JSON URL.
# Defaults to https://raw.githubusercontent.com/ElleryHe/FeedCourier-Plugins/main/index.json
# with a built-in compiled snapshot fallback for air-gapped deployments.
# PLUGIN_INDEX_URL=
